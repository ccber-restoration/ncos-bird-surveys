
###    Bayesian Model Formula    ###


# ----------------------------------
# Program: JAGS
# Time   : 2026-01-20 17:25:24
# ------------------------------



# Data formulation

data {

	c1 <- c[1]
}




# Model formulation

model {

	# Initialisation of level of CI95%
	for (i in 1:k) {
		sd[i]   <- (h[i] - l[i]) / 3.93
		prec[i] <- pow(sd[i], -2)
	}

	for (i in 1:(k - 1)) {
		lint[i] <- t[i + 1] - t[i]
	}

	linttot <- t[k] - t[1]

	minN1 <- c1 / 2
	maxN1 <- c1 * 2

	# Priors and constraints
	N[1] ~ dunif(minN1, maxN1)

	# Likelihood - State process
	logN[1]  <- log(N[1])
	rcand[1] ~ dnorm(0, 1)
	r[1]     <- min(rcand[1], rmax)
	rcum[1]  <- lint[1] * r[1]
	r2cum[1] <- rcum[1] * r[1]
	logN[2]  <- logN[1] + rcum[1]
	N[2]     <- exp(logN[2])

	for (i in 2:(k - 1)) {
		rcand[i] ~ dnorm(r[i - 1], lability)
		r[i]        <- min(rcand[i], rmax)
		rcum[i]     <- lint[i] * r[i]
		r2cum[i]    <- rcum[i] * r[i]
		logN[i + 1] <- logN[i] + rcum[i]
		N[i + 1]    <- exp(logN[i + 1])
	}

	# Likelihood - Observation process
	for (i in 1:k) {
		c[i] ~ dnorm(N[i], prec[i])
	}

	# derived interesting quantities
	meanr  <- sum(rcum[]) / linttot
	sdr    <- sqrt(sum(r2cum[]) / linttot - meanr * meanr)
	vrrmax <- sdr / rmax

}

